package nursetempl

import (
	"geevly/internal/student"
	"geevly/internal/school"
	"fmt"
)

type StudentWithHealthStatus struct {
	Student             *student.ProjectedStudent
	HasRecentAssessment bool
	LastAssessmentDate  string
}

templ StudentList(schoolID string, school *school.Aggregate, students []StudentWithHealthStatus) {
	<div class="container mx-auto px-4 py-6 max-w-lg">
		<div class="flex justify-between items-center mb-4">
			<h1 class="text-xl font-bold">Health Assessments</h1>
			<button
				class="rounded-lg bg-white px-4 py-3 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
				hx-get="/nurse"
			>
				Back
			</button>
		</div>
		<p class="text-sm text-gray-500 mb-4">{ school.GetData().Name }</p>
		<div class="divide-y divide-gray-200 border border-gray-200 rounded-lg overflow-hidden">
			for _, s := range students {
				if s.HasRecentAssessment {
					<div class="bg-green-50 p-4">
						<div class="flex items-center justify-between">
							<div>
								<p class="font-semibold text-gray-800">{ s.Student.FirstName } { s.Student.LastName }</p>
								<p class="text-sm text-gray-500">Grade { fmt.Sprintf("%d", s.Student.Grade) } · { s.Student.StudentID }</p>
							</div>
							<div class="text-right">
								<span class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-700">&#10003; Done</span>
								<p class="text-xs text-green-600 mt-1">{ s.LastAssessmentDate }</p>
							</div>
						</div>
					</div>
				} else {
					<a
						class="block bg-red-50 p-4 active:bg-red-100 cursor-pointer"
						hx-get={ fmt.Sprintf("/nurse/school/%s/student/%d?return_to=/nurse/school/%s", schoolID, s.Student.ID, schoolID) }
					>
						<div class="flex items-center justify-between">
							<div>
								<p class="font-semibold text-gray-800">{ s.Student.FirstName } { s.Student.LastName }</p>
								<p class="text-sm text-gray-500">Grade { fmt.Sprintf("%d", s.Student.Grade) } · { s.Student.StudentID }</p>
							</div>
							<div class="flex items-center">
								<span class="inline-flex items-center rounded-lg bg-indigo-600 px-8 py-3 text-sm font-semibold text-white shadow-sm">Assess</span>
							</div>
						</div>
					</a>
				}
			}
		</div>
	</div>
}
