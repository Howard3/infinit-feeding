package nursetempl

import (
	"geevly/internal/student"
	"geevly/internal/webapi/templates/components"
	"fmt"
)

templ Success(studentAgg *student.Aggregate, heightCm float32, weightKg float32, bulkUploadID string, returnTo string) {
	<div class="container mx-auto px-4 py-6 max-w-md">
		<div class="bg-green-50 border-2 border-green-200 shadow rounded-lg p-6 text-center">
			<div class="text-green-600 mb-4" style="font-size: 64px; line-height: 1;">&#10003;</div>
			<h1 class="text-3xl font-bold text-green-800 mb-2">Assessment Recorded</h1>
			<p class="text-lg text-gray-600 mb-6">Health assessment for <strong>{ studentAgg.GetFullName() }</strong> has been saved.</p>
			<div class="bg-white rounded-lg p-5 mb-6 w-full text-left">
				<div class="grid grid-cols-2 gap-3 text-lg">
					<span class="font-semibold text-gray-500">Height:</span>
					<span class="font-bold">{ fmt.Sprintf("%.1f cm", heightCm) }</span>
					<span class="font-semibold text-gray-500">Weight:</span>
					<span class="font-bold">{ fmt.Sprintf("%.1f kg", weightKg) }</span>
				</div>
			</div>
			<div class="flex flex-col gap-3 w-full">
				if returnTo != "" {
					<button
						class="w-full rounded-lg bg-indigo-600 px-6 py-4 text-lg font-semibold text-white shadow-sm hover:bg-indigo-500 active:bg-indigo-700"
						hx-get={ returnTo }
					>
						Back to Class List
					</button>
				} else {
					<button
						class="w-full rounded-lg bg-indigo-600 px-6 py-4 text-lg font-semibold text-white shadow-sm hover:bg-indigo-500 active:bg-indigo-700"
						hx-get="/nurse"
					>
						Assess Another Student
					</button>
				}
				<form method="post" action="/nurse/record/undo" class="w-full">
					@components.HiddenField("student_id", studentAgg.GetID())
					@components.HiddenField("bulk_upload_id", bulkUploadID)
					<button
						type="submit"
						class="w-full rounded-lg bg-red-600 px-6 py-4 text-lg font-semibold text-white shadow-sm hover:bg-red-500 active:bg-red-700"
						hx-confirm="Are you sure you want to undo this assessment?"
					>
						Undo Assessment
					</button>
				</form>
			</div>
		</div>
	</div>
}
