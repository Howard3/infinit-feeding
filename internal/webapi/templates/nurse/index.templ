package nursetempl

import (
	"geevly/internal/school"
	"geevly/internal/webapi/templates/components"
	"fmt"
)

templ Index(nurseEnrollments []*school.Aggregate) {
	<div class="container mx-auto px-4 py-8">
		<h1 class="text-2xl font-bold mb-6">Nurse Dashboard</h1>
		<div class="mb-8 bg-white shadow rounded-lg p-6">
			<h2 class="text-lg font-semibold mb-4">Quick Assessment</h2>
			<div class="grid md:grid-cols-2 gap-6">
				<div class="flex flex-col items-center gap-3 rounded bg-gray-50 p-4 border border-gray-200">
					<h3 class="text-md font-medium">Scan QR Code</h3>
					<p class="text-sm text-gray-500 text-center">Scan a student's QR code to start an assessment.</p>
					@components.PrimaryButton("Scan QR Code", templ.Attributes{
						"hx-get": "/nurse/scan",
					})
				</div>
				<form autocomplete="off" class="flex flex-col items-center gap-3 rounded bg-gray-50 p-4 border border-gray-200">
					<h3 class="text-md font-medium">Enter Student LRN</h3>
					<p class="text-sm text-gray-500 text-center">No QR Code? Enter the student's LRN to look them up.</p>
					@components.TextField("Student LRN", "student_school_id", "Enter student LRN", "")
					<button
						hx-get="/nurse/studentBy/studentSchoolID"
						hx-include="#student_school_id"
						class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
					>
						Look Up
					</button>
				</form>
			</div>
		</div>
		<h2 class="text-lg font-semibold mb-4">Your Schools</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			for _, s := range nurseEnrollments {
				<div class="bg-white shadow rounded-lg p-4">
					<h2 class="text-xl font-semibold mb-2">{ s.GetData().Name }</h2>
					@components.PrimaryButton("View Class List", templ.Attributes{
						"hx-get": fmt.Sprintf("/nurse/school/%d", s.ID),
					})
				</div>
			}
		</div>
	</div>
}

templ NoSchoolAssigned() {
	<div class="container mx-auto px-4 py-8">
		<div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 rounded" role="alert">
			<h2 class="font-bold text-lg mb-2">No School Assigned</h2>
			<p>You are not currently assigned to any school as a nurse.</p>
			<p class="mt-2">Please contact an administrator to get assigned to a school.</p>
		</div>
	</div>
}
