package nursetempl

import (
	"geevly/internal/student"
	"geevly/internal/webapi/templates/components"
	"fmt"
)

templ AssessmentForm(studentAgg *student.Aggregate, returnTo string) {
	<div class="container mx-auto px-4 py-6 max-w-md">
		<h1 class="text-2xl font-bold mb-4">Record Health Assessment</h1>
		<div class="relative rounded-lg overflow-hidden shadow mb-4">
			<img
				src={ fmt.Sprintf("/student/profile/photo/%s", studentAgg.GetStudent().ProfilePhotoId) }
				alt="Profile Photo"
				class="w-full rounded-lg"
			/>
			<div class="absolute bottom-0 left-0 right-0 px-4 py-3" style="background: rgba(0,0,0,0.3); backdrop-filter: blur(4px);">
				<h2 class="text-2xl font-bold text-white" style="text-shadow: 0 0 6px black, 0 0 12px black;">{ studentAgg.GetFullName() }</h2>
				<p class="text-base mt-0.5" style="color: rgba(255,255,255,0.8); text-shadow: 0 0 6px black, 0 0 12px black;">Student ID: { studentAgg.GetStudent().StudentSchoolId }</p>
			</div>
		</div>
		<form class="bg-white shadow rounded-lg p-5 space-y-5" hx-post="/nurse/record" hx-push-url="false">
			@components.HiddenField("student_id", studentAgg.GetID())
			if returnTo != "" {
				@components.HiddenField("return_to", returnTo)
			}
			<div class="space-y-2">
				<label class="text-base font-semibold leading-none" for="height_cm">
					Height (cm)
				</label>
				<input
					class="flex w-full rounded-lg border-2 border-gray-300 bg-white px-4 py-4 text-lg ring-offset-background placeholder:text-gray-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"
					id="height_cm"
					name="height_cm"
					type="number"
					step="0.1"
					min="50"
					max="250"
					inputmode="decimal"
					placeholder="e.g. 120.5"
					required=""
				/>
			</div>
			<div class="space-y-2">
				<label class="text-base font-semibold leading-none" for="weight_kg">
					Weight (kg)
				</label>
				<input
					class="flex w-full rounded-lg border-2 border-gray-300 bg-white px-4 py-4 text-lg ring-offset-background placeholder:text-gray-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"
					id="weight_kg"
					name="weight_kg"
					type="number"
					step="0.1"
					min="5"
					max="200"
					inputmode="decimal"
					placeholder="e.g. 25.3"
					required=""
				/>
			</div>
			<div class="pt-2">
				<button
					class="w-full rounded-lg bg-indigo-600 px-6 py-4 text-lg font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 active:bg-indigo-700"
				>
					Record Assessment
				</button>
			</div>
		</form>
	</div>
}
